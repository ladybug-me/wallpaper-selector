settings-filter-appearance-card = Appearance
settings-filter-appearance-card-desc = Match the filter bar to each picker layout, or force one style everywhere.
settings-filter-visual-style-label = Visual style
settings-filter-visual-style-desc = Match picker uses the skewed bar in Slices and Sandy, the geometric bar in Geometric, and the straight bar in Wall.
settings-filter-visual-style-match = Match picker
settings-filter-visual-style-slices = Slices
settings-filter-visual-style-hex = Geometric
settings-filter-visual-style-wall = Wall
settings-filter-orientation-label = Orientation
settings-filter-orientation-desc = Place the filter controls above the picker or in a vertical rail beside it.
settings-filter-orientation-horizontal = Horizontal
settings-filter-orientation-vertical = Vertical
settings-filter-type-chips-card = Type chips
settings-filter-type-chips-card-desc = Show or hide individual wallpaper-type chips.
settings-filter-type-images = Images
settings-filter-type-videos = Videos
settings-filter-type-we = Wallpaper Engine
settings-filter-type-all = All
settings-filter-sort-options-card = Sort options
settings-filter-sort-options-card-desc = Show or hide individual sort buttons.
settings-filter-other-controls-card = Other controls
settings-filter-other-controls-card-desc = Show or hide the remaining filter-bar controls.
settings-filter-show-folder-label = Folder filter
settings-filter-show-folder-desc = Show a folder dropdown when the wallpaper folder contains subfolders.
settings-filter-show-favourites-label = Favourites
settings-filter-show-favourites-desc = Show the button that limits results to favourites.
settings-filter-show-random-label = Random rotation
settings-filter-show-random-desc = Show the button that starts or stops random rotation.
settings-filter-show-colors-label = Colour filters
settings-filter-show-colors-desc = Show the colour swatches used to filter wallpapers by their dominant colour.
settings-filter-show-theme-label = Theme toggle
settings-filter-show-theme-desc = Show the light and dark theme buttons.
settings-filter-show-tag-cloud-label = Tag-cloud button
settings-filter-show-tag-cloud-desc = Show the button that opens tag and description search.
settings-filter-show-resolution-label = Resolution filter
settings-filter-show-resolution-desc = Show the cycling resolution-range button when presets exist.
settings-filter-resolution-presets-card = Resolution presets
settings-filter-resolution-presets-card-desc = Each preset becomes one option in the filter bar's Size button. Width and height must both fall within its range.
settings-filter-preset-item-label = Preset { $index }
settings-filter-preset-item-desc = Expand to edit the label and resolution range.
settings-filter-preset-label-label = Label
settings-filter-preset-name-desc = The short label shown in the filter bar, for example FHD, 2K, or 4K.
settings-filter-preset-name-placeholder = e.g. 4K
settings-filter-preset-orientation-label = Orientation
settings-filter-preset-orientation-desc = Limit this preset to wide or tall wallpapers.
settings-filter-preset-orientation-wide = WIDE
settings-filter-preset-orientation-tall = TALL
settings-filter-preset-from-label = From
settings-filter-preset-from-desc = Smallest resolution included in the selected orientation.
settings-filter-preset-to-label = To
settings-filter-preset-to-desc = Largest resolution included. Leave empty for no upper limit.
settings-filter-preset-resolution-placeholder = e.g. 1920x1080
settings-filter-preset-remove-desc = Remove this resolution preset.
settings-filter-remove-action = Remove
settings-filter-add-preset-label = Add resolution
settings-filter-add-preset-desc = Add an empty preset, then give it an orientation, label, and range.
settings-filter-add-action = Add
settings-filter-default-folder-card = Default folder
settings-filter-default-folder-card-desc = Folder shown when the picker opens. You can still switch in the bar.
settings-filter-default-folder-label = Folder
settings-filter-default-folder-desc = All folders shows everything; pick one to filter by default.
settings-filter-all-folders = All folders
settings-filter-main-folder = Main
settings-filter-sticky-label = Sticky filters
settings-filter-sticky-desc = Keep type, folder, colour, sort, and favourite filters after the picker closes. A remembered folder overrides the default above.
settings-filter-position-card = Filter bar position
settings-filter-position-card-desc = Move the filter bar horizontally or vertically in pixels. Positive horizontal offsets move it right; positive vertical offsets move it down.
settings-filter-offset-x-label = Filter bar horizontal offset
settings-filter-offset-x-desc = Move the filter bar left or right relative to this picker.
settings-filter-offset-y-label = Filter bar vertical offset
settings-filter-offset-y-desc = Move the filter bar up or down relative to this picker.
settings-filter-visibility-card = Visibility
settings-filter-visibility-card-desc = Pin the bars open instead of letting them auto-hide.
settings-filter-always-visible-label = Always show filter bar
settings-filter-always-visible-desc = Keep the filter bar pinned visible instead of auto-hiding.
settings-filter-weather-card = Weather filter
settings-filter-weather-card-desc = Match wallpapers to the current weather for your location.
settings-filter-weather-label = Match current weather
settings-filter-weather-desc = Fetch the weather from Open-Meteo when the picker opens and show wallpapers with matching weather tags. Off shows every wallpaper.
settings-filter-location-label = Location
settings-filter-location-desc = City name looked up for current weather (e.g. London). Leave empty to use the latitude/longitude from the Schedule tab instead.
settings-filter-location-placeholder = e.g. London
